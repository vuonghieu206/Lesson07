@model IEnumerable<Demo7.Models.DataModels.Member>

<h2>Danh sách thành viên</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">
        Thêm thành viên
    </a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>UserName</th>
            <th>Họ tên</th>
            <th>Email</th>
            <th>Điện thoại</th>
            <th>Ngày sinh</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.UserName</td>
                <td>@item.FullName</td>
                <td>@item.Email</td>
                <td>@item.Phone</td>
                <td>@item.Birthday.ToString("dd/MM/yyyy")</td>
            </tr>
        }
    </tbody>
</table>