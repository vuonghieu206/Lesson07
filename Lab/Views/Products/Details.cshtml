@model MyAppMVC.Models.Product
@{ ViewData["Title"] = "Chi tiết sản phẩm"; }
<h1>Chi tiết sản phẩm</h1>
<dl class="row">
    <dt class="col-sm-2">Tên sản phẩm</dt><dd class="col-sm-10">@Model.Name</dd>
    <dt class="col-sm-2">Ảnh</dt><dd class="col-sm-10"><img src="~/products/@Model.Image" alt="@Model.Name" class="product-preview" /></dd>
    <dt class="col-sm-2">Giá chuẩn</dt><dd class="col-sm-10">@Model.Price.ToString("N0")</dd>
    <dt class="col-sm-2">Giá khuyến mãi</dt><dd class="col-sm-10">@Model.SalePrice.ToString("N0")</dd>
    <dt class="col-sm-2">Mô tả</dt><dd class="col-sm-10">@Model.Description</dd>
    <dt class="col-sm-2">Danh mục</dt><dd class="col-sm-10">@Model.Category?.Name</dd>
</dl>
<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Sửa</a>
<a asp-action="Index" class="btn btn-secondary">Quay lại</a>
