@model MyAppMVC.Models.Product
<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
<div class="mb-3">
    <label asp-for="Name" class="form-label">Tên sản phẩm</label>
    <input asp-for="Name" class="form-control" />
    <span asp-validation-for="Name" class="text-danger"></span>
</div>
<div class="mb-3">
    <label for="imageFile" class="form-label">Ảnh sản phẩm</label>
    <input type="file" id="imageFile" name="imageFile" accept="image/jpeg,image/png,image/gif,image/webp" class="form-control" />
    <span asp-validation-for="Image" class="text-danger"></span>
    @if (!string.IsNullOrEmpty(Model.Image)) { <div class="mt-2"><img src="~/products/@Model.Image" class="product-preview" alt="Ảnh sản phẩm" /></div> }
</div>
<div class="mb-3">
    <label asp-for="Price" class="form-label">Giá chuẩn</label>
    <input asp-for="Price" type="number" min="100000" step="0.01" class="form-control" />
    <span asp-validation-for="Price" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="SalePrice" class="form-label">Giá khuyến mãi</label>
    <input asp-for="SalePrice" type="number" min="0" step="0.01" class="form-control" />
    <span asp-validation-for="SalePrice" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="Description" class="form-label">Mô tả</label>
    <textarea asp-for="Description" rows="4" maxlength="1500" class="form-control"></textarea>
    <span asp-validation-for="Description" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="CategoryId" class="form-label">Danh mục</label>
    <select asp-for="CategoryId" asp-items="ViewBag.CategoryId" class="form-select">
        <option value="">-- Chọn danh mục --</option>
    </select>
    <span asp-validation-for="CategoryId" class="text-danger"></span>
</div>
